// Shared build settings. Secrets and the Apple Team ID never live in git (D-33):
// put them into Config/Local.xcconfig (ignored) or pass them on the command line.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// D-51: tasks, calendar, daily notes and tabs ("extended mode"). NO = the notes-only app.
DS_EXTENDED_MODE = NO

// Team ID: Config/Local.xcconfig `DS_TEAM_ID = XXXXXXXXXX` or `DS_TEAM_ID=...` on xcodebuild.
DS_TEAM_ID =
DEVELOPMENT_TEAM = $(DS_TEAM_ID)

#include? "Local.xcconfig"
