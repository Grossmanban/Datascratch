          "stringUnit": {
            "state": "translated",
            "value": "(копия)"
          }
        }
      }
    },
    "AI agents with a token can read and edit it. The key is kept on the server, so the server can technically read these notes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-агенты с токеном могут читать и править его. Ключ хранится на сервере, поэтому сервер технически может прочитать эти заметки."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
