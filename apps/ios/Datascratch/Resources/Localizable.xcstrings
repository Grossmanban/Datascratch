      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "до %@"
          }
        }
      }
    },
    "until revoked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "до отзыва"
          }
        }
      }
    }
