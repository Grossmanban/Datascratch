# Datascratch server configuration. Copy to .env and fill in the secrets.
# Generate a 32-byte secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Public address of the server (used in links and OpenAPI)
PUBLIC_URL=https://notes.example.com
# Web client origins allowed to call the API (comma-separated); empty = same origin only
# Web app address (OAuth consent page of AI agents sends users there to sign in)
APP_URL=https://app.example.com
CORS_ORIGINS=
# MCP clients (Claude, ChatGPT): advertise OAuth Client ID Metadata Documents. Set false if the server
# cannot reach the clients' hosts (e.g. claude.ai from some regions) — clients then register dynamically.
OAUTH_CLIENT_METADATA_DOCUMENTS=true

DATABASE_URL=postgres://datascratch:change-me@postgres:5432/datascratch
DATABASE_POOL_MAX=10
DB_MIGRATE_ON_START=true

# Signs access and guest tokens. Changing it signs everyone out.
DS_JWT_SECRET=
# Wraps notebook keys of "for agents" notebooks. NEVER lose it and never put it in the database
# or in the same backup as the database: without it agent-mode notebooks cannot be read by agents.
DS_KMS_KEY=

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# File storage: disk (default) or s3
STORAGE_DRIVER=disk
STORAGE_DIR=/data/files
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=auto
# S3_BUCKET=datascratch
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
# S3_FORCE_PATH_STYLE=true

ATTACHMENT_MAX_BYTES=209715200
SYNC_UPDATE_MAX_BYTES=2097152
SYNC_SNAPSHOT_MAX_BYTES=52428800
SYNC_AWARENESS_MAX_BYTES=65536
SYNC_RATE_PER_SEC=100

# Version history retention (days)
HISTORY_KEEP_ALL_DAYS=7
HISTORY_DAILY_DAYS=30
HISTORY_WEEKLY_DAYS=365
COVERED_UPDATES_KEEP_DAYS=7

JOBS_ENABLED=true

# Optional: enables GET /metrics (Prometheus) with header  Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
