    "e2e": "playwright test",
    "mock-server": "node e2e/mock-server/server.mjs",
    "e2e:build": "VITE_DS_SERVER_URL=http://localhost:8787 VITE_DS_TEST_HOOKS=1 vite build && VITE_DS_SERVER_URL=http://localhost:8787 VITE_DS_TEST_HOOKS=1 VITE_DS_EXTENDED_MODE=1 vite build --outDir dist-ext && playwright test"
