{"nodes": [{"id": "docs_decisions_0045_agent_created_notes_no_line_highlight_for_agent_created_note", "label": "D-45: note created wholly by an agent is not highlighted line by line", "file_type": "rationale", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0420\u0415\u0428\u0415\u041d\u041e (user, 2026-10-26). Under D-10 every agent-inserted text got the agentEdit mark; a note Claude created from scratch opened fully green and underlined \u2014 highlighting distinguished nothing and hindered reading. Trade-off: needs a new NoteMeta field. Edits in existing notes stay highlighted per D-10."}, {"id": "docs_decisions_0045_agent_created_notes_createdbyagent_field", "label": "NoteMeta.createdByAgent { agentId: grantId, agentName, at }", "file_type": "concept", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0045_agent_created_notes_created_by_agent_banner", "label": "\u00ab\u0421\u043e\u0437\u0434\u0430\u043d\u043e \u0430\u0433\u0435\u043d\u0442\u043e\u043c {agentName}\u00bb banner with \u00ab\u041f\u043e\u043d\u044f\u0442\u043d\u043e\u00bb button", "file_type": "concept", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0045_agent_created_notes_agent_edits_accept_all_bar", "label": "\u00ab\u041f\u0440\u0430\u0432\u043a\u0438 \u0430\u0433\u0435\u043d\u0442\u0430 \u00b7 \u041f\u0440\u0438\u043d\u044f\u0442\u044c \u0432\u0441\u0435\u00bb bar and per-block accept for agent edits in existing notes", "file_type": "concept", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0045_agent_created_notes_highlight_all_until_accept_rejected", "label": "Rejected option: highlight everything until \u00ab\u041f\u0440\u0438\u043d\u044f\u0442\u044c \u0432\u0441\u0435\u00bb", "file_type": "concept", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing to change, but the whole note turns green and the highlight communicates nothing."}, {"id": "docs_decisions_0045_agent_created_notes_legacy_marked_notes", "label": "Already-created agent notes keep their agentEdit marks (removed by \u00ab\u041f\u0440\u0438\u043d\u044f\u0442\u044c \u0432\u0441\u0435\u00bb)", "file_type": "concept", "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_0045_agent_created_notes_no_line_highlight_for_agent_created_note", "target": "docs_decisions_0010_agent_edits_immediate_agent_edits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0045_agent_created_notes_no_line_highlight_for_agent_created_note", "target": "docs_decisions_0045_agent_created_notes_createdbyagent_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0045_agent_created_notes_no_line_highlight_for_agent_created_note", "target": "docs_decisions_0045_agent_created_notes_created_by_agent_banner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0045-agent-created-notes.md", "source_location": null, "weight": 1.0}, {"sourc