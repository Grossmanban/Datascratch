ation": "L28-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_margin_note_text_column_coords", "label": "Margin note coords from text column: x in column widths (may be <0 or >1), y from paragraph top", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_live_stroke_anchoring", "label": "Live stroke anchoring: each point bound to nearest character of its line, offset in em", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L48-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_right_char_boundary_rule", "label": "Point exactly on a boundary between two characters binds to the right character; at line end - to the last character", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clarification agreed by ios-editor and web-editor streams (2026-10-25) so both platforms anchor identically."}, {"id": "docs_architecture_contracts_strokes_render_after_reflow", "label": "Render after reflow: anchor -> absolute position (with redone items) -> current glyph rect", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L57-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_line_break_segmentation", "label": "Line-break segmentation: adjacent points on different line fragments -> separate segments", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_deleted_text_rendering", "label": "D-35 rendering: points of deleted characters not drawn, stroke kept in document; deletion checked on the Yjs item itself", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs resolves a deleted char's relative position to a neighbour, so deletion must be checked on the item; keeping the stroke lets undo of text deletion bring the mark back."}, {"id": "docs_architecture_contracts_strokes_circles_arrows_stretch", "label": "Circles and arrows stretch with text; change goes through coordinator if bad in practice", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_rebase_redone_anchors", "label": "rebaseRedoneAnchors(doc): undo/redo client rewrites anchors to redone items in same transaction (DSCore equivalent on iOS)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Yjs 'redone' link is local, not in updates, and does not survive reload; other devices would see new items and anchors pointing at deleted chars."}, {"id": "docs_architecture_contracts_strokes_version_restore_rebase", "label": "Version restore: restore content and strokes; anchors recomputed via absolute indices", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_block_restructure_reanchoring", "label": "Block restructure (\u00a74.1a): split/merge/type change/move -> replace affected stroke with copy (new strokeId, same points, remapped anchors)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L73-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "y-prosemirror recreates moved text as new Yjs items, so without this the mark would vanish under D-35."}, {"id": "docs_architecture_contracts_strokes_tracked_origin_undo_merge", "label": "Web: stroke copy written right after y-prosemirror transaction with tracked origin; Y.UndoManager merges into one undo step", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_reanchor_strokes", "label": "captureAnchorOffsets -> reanchorStrokes (@datascratch/shared/strokes)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_orphaned_at", "label": "orphanedAt: local mark when all anchors first deleted; orphan strokes older than 30 days purged at history compaction", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs does not store when text was deleted, so the client tracks it locally (fallback createdAt)."}, {"id": "docs_architecture_contracts_strokes_width_curve", "label": "Width: width x f(pressure) x scale; f(p)=0.35+0.65*p^0.8; tilt only for pencil/marker; highlighter under text with multiply", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L83-L85", "source_url": null, "captured_at": null, 