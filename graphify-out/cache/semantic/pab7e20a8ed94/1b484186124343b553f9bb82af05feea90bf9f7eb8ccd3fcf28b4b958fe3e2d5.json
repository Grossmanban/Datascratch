, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_server_argon2id", "label": "Server stores Argon2id(loginKey) and Argon2id(recoveryLoginKey) with light params (m=19 MiB, t=2)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys are already high-entropy; the client did the heavy Argon2id itself."}, {"id": "docs_spec_06_data_server_prelogin_fake_salt", "label": "prelogin for unknown email returns deterministic fake salt (HMAC of server secret); equal timing for unknown emails", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents account enumeration by response content or timing."}, {"id": "docs_spec_06_data_server_device_session", "label": "Device = session; access JWT 15 min with userId and deviceId; device revocation immediate (checked per request, WebSocket closed)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L45,L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_refresh_token_rotation", "label": "One-time refresh token (30 days) with rotation; reuse = theft, whole device revoked; client refreshes sequentially", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_recovery_key_replacement", "label": "Recovery key replacement POST /v1/auth/recovery-key (password-confirmed): old key stops working, pending recoveries cancelled", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_security_events", "label": "Security journal GET /v1/me/security-events: password change, recovery, key replacement", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_password_change_revocation", "label": "Password change revokes all other devices; recovery via recovery key revokes all (new session issued)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sync_rules", "label": "Sync rules: gapless seq under doc row lock, ordered live delivery, idempotent push by clientMsgId; deviceId forms user / guest:<hash> / agent:<grantId>; bad_request vs protocol_mismatch; doc_not_found on deletion", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L53-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sync_limits", "label": "Sync limits: update 2 MB, snapshot 50 MB, awareness 64 KB, 100 msg/s per connection (burst \u00d75); awareness only for subscribed docs", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_client_snapshots", "label": "Client-made snapshots (>500 updates or >1 MB); server snapshots for agent-mode notebooks after agent edits", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_snapshot_on_close", "label": "Snapshot on leaving a document after \u226530 edits since last snapshot (proposed by web-app)", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise history versions would be too sparse."}, {"id": "docs_spec_06_data_server_history_retention_policy", "label": "History versions = snapshots (GET /v1/docs/:id/versions); covered updates kept 7 days; snapshots all for 7 days, daily to 30 days, weekly to a year, monthly after; HISTORY_* env", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L63-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_first_sync_batching", "label": "First sync batched: 200 docs per query when \u2264100 updates, backpressure at 4 MB unread; bench ~1.2 s server-side for 10k notes", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_snapshot_first_subscribe", "label": "subscribe with since < last snapshot seq always gets snapshot + later updates (sync-protocol \u00a75 change 2026-10-26)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A device unable to read some updates (e.g. encrypted with the wrong key due to a client bug) recovers from a later healthy snapshot; clients already apply snapshots, so compatible."}, {"id": "docs_spec_06_data_server_notebook_share_scope", "label": "Sharing a notebook grants its index and all its notes, including ones created later; deleting a note/notebook revokes its links", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L71,L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_guest_token", "label": "Guest token lives as long as the link; revocation disconnects guests; can read and (with edit) upload attachments, never delete", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_agents_package", "label": "@datascratch/agents package (agents stream); server provides grants/OAuth/log storage, document decryption, user login", "file_type": "code", "source_file": "docs/spec/06-data-server.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_agents_rls", "label": "Agent requests run under PostgreSQL role ds_agent with Row-Level Security per grant; notebook key decrypted only inside that query", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L78-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even a buggy query in code cannot read or write someone else's notebook; revoked/expired grant sees nothing; switching notebook to private cuts agents immediately."}, {"id": "docs_spec_06_data_server_oauth_consent", "label": "OAuth consent screen in browser; web app sets session cookie via POST /v1/auth/web-session", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_metrics", "label": "Prometheus GET /metrics gated by METRICS_TOKEN bearer; no route without token", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_move_note", "label": "Move note between notebooks: PATCH /v1/docs/:id { notebookId 