{"nodes": [{"id": "docs_spec_08_sharing_share_link", "label": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u0437\u0430\u043c\u0435\u0442\u043a\u0443 \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u043d\u043e\u0442: \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440/\u043f\u0440\u0430\u0432\u043a\u0430, \u0441\u0440\u043e\u043a, \u043e\u0442\u0437\u044b\u0432 (D-13)", "file_type": "concept", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_08_sharing_guest_no_account", "label": "\u0413\u043e\u0441\u0442\u044c \u0431\u0435\u0437 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0441\u0441\u044b\u043b\u043a\u0443 \u0432 \u043b\u044e\u0431\u043e\u043c \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u0438 \u0441\u0440\u0430\u0437\u0443 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0443\u0435\u0442", "file_type": "concept", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_08_sharing_key_in_url_fragment", "label": "\u041a\u043b\u044e\u0447 \u0432 \u0447\u0430\u0441\u0442\u0438 \u0441\u0441\u044b\u043b\u043a\u0438 \u043f\u043e\u0441\u043b\u0435 # \u2014 \u043d\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440; \u0432\u0435\u0431 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0435\u0433\u043e \u0438\u0437 \u0430\u0434\u0440\u0435\u0441\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0438", "file_type": "rationale", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0428\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0435 \u043b\u043e\u043c\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0448\u0435\u0440\u0438\u043d\u0433\u0435 (\u043a\u0430\u043a \u0432 Excalidraw); \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0438\u0437 \u0430\u0434\u0440\u0435\u0441\u0430 \u2014 \u043f\u043e \u0430\u0443\u0434\u0438\u0442\u0443 2026-10-27."}, {"id": "docs_spec_08_sharing_realtime_collaboration", "label": "\u0421\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u0430\u044f \u043f\u0440\u0430\u0432\u043a\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438, \u043a\u0443\u0440\u0441\u043e\u0440\u044b \u0438 \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 (\u0433\u043e\u0441\u0442\u0438 \u2014 \u00ab\u0413\u043e\u0441\u0442\u044c\u00bb)", "file_type": "concept", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_08_sharing_ios_presence_avatars", "label": "\u0410\u0432\u0430\u0442\u0430\u0440\u044b \u043f\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044f \u043d\u0430 iOS \u0432 \u0432\u0435\u0440\u0445\u043d\u0435\u0439 \u043f\u0430\u043d\u0435\u043b\u0438 (iPhone \u0434\u0432\u0430 \u0438 \u00ab+N\u00bb, iPad \u0442\u0440\u0438)", "file_type": "concept", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_08_sharing_own_devices_not_collaborators", "label": "\u0421\u0432\u043e\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u2014 \u043d\u0435 \u0441\u043e\u0430\u0432\u0442\u043e\u0440\u044b: awareness user.account (\u0441\u0442\u0440\u043e\u043a\u0430 \u226464)", "file_type": "concept", "source_file": "docs/spec/08-sharing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_08_sharing_web_page_link_open_in_app", "label": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\