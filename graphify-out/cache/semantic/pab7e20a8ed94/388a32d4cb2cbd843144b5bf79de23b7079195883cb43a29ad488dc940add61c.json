{"nodes": [{"id": "docs_decisions_0046_faster_ios_ci_d_46", "label": "D-46 Faster iOS CI", "file_type": "rationale", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TestFlight builds waited ~40 min for iOS checks plus ~30 min build; repeat runs on main occupied scarce macOS runners and builds waited for the full UI suite. Chosen: no repeats on main + smoke gate + 3 parallel shards (free for public repo) over paid faster runners or doing nothing."}, {"id": "docs_decisions_0046_faster_ios_ci_gate_step", "label": "gate step (skip repeat iOS runs on main)", "file_type": "concept", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On push to main, a light Linux step looks for a successful run of the same workflow on a commit with identical tracked files and skips macOS jobs, removing ~20 min queueing."}, {"id": "docs_decisions_0046_faster_ios_ci_already_tested_script", "label": ".github/scripts/already-tested.sh", "file_type": "code", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0046_faster_ios_ci_smoke_ui_tests", "label": "SMOKE_UI_TESTS release gate", "file_type": "concept", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical scenarios (launch, editor, pen palette, keyboard hide, iPad columns, device revoked, Russian UI) verify in minutes; TestFlight starts once smoke is green on iPhone and iPad, full-suite failures go into the next build."}, {"id": "docs_decisions_0046_faster_ios_ci_wait_release_gate", "label": "tools/ci/wait-release-gate.sh", "file_type": "code", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0046_faster_ios_ci_ui_test_shards", "label": "Parallel UI test shards (UI_SHARDS = 3)", "file_type": "concept", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amendment 2026-11-08 after user asked why one check took 45 min: Build job per device shares products artifact; Unit & smoke and three UI shards run concurrently; full suite ~15-20 min instead of ~45."}, {"id": "docs_decisions_0046_faster_ios_ci_ui_test_shard_script", "label": "apps/ios/scripts/ui-test-shard.py", "file_type": "code", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0046_faster_ios_ci_shard_coverage_check", "label": "Check the UI shards cover every test", "file_type": "concept", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensures no test is lost: shards plus smoke set must equal the full suite exactly once, otherwise the run fails."}, {"id": "docs_decisions_0046_faster_ios_ci_testflight_build", "label": "TestFlight build (ios-release)", "file_type": "concept", "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_0046_faster_ios_ci_d_46", "target": "docs_decisions_0046_faster_ios_ci_gate_step", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0046-faster-ios-ci.md", "source_location": "L16", "weight": 1.0}, {"source": "