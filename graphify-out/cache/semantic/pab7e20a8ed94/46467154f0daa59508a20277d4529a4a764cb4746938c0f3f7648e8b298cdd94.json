{"nodes": [{"id": "docs_decisions_0054_account_sharing_simple_d54", "label": "D-54 Account-based collaboration \u2014 simple variant (\u0420\u0415\u0428\u0415\u041d\u041e, user 2026-10-27: \u00ab\u043f\u043e\u043f\u0440\u043e\u0449\u0435\u2026 \u0441\u043b\u043e\u0436\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u0430 \u043d\u0435 \u043d\u0430\u0434\u043e, \u043d\u0430\u0441 \u043d\u0435\u043c\u043d\u043e\u0433\u043e\u00bb)", "file_type": "rationale", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft project proposed Notion-level work (five roles, groups, admins, private notebooks, audit log, AI policy); the team is small, the user wants simple"}, {"id": "docs_decisions_0054_account_sharing_simple_link_only_context", "label": "Context: today sharing only by link (D-13); a person with an account opens it as guest and edits are signed \u00ab\u0413\u043e\u0441\u0442\u044c\u00bb", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_share_notebook_or_note_by_email", "label": "Share a notebook or a single note with a specific account holder by email; whole spaces and folders are not shared", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_role_can_edit", "label": "Role \u00ab\u041c\u043e\u0436\u0435\u0442 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u00bb: read, edit text, draw with pen, create and delete notes in shared notebook", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_role_read_only", "label": "Role \u00ab\u0422\u043e\u043b\u044c\u043a\u043e \u0447\u0442\u0435\u043d\u0438\u0435\u00bb: read, search, copy, export; server rejects changes from this role", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_owner_manages_access", "label": "Only the owner (who shared) manages access: invites, changes role, revokes", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_invitation_flow", "label": "Invitation: \u00ab\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f\u00bb \u2192 email \u2192 role \u2192 \u00ab\u041f\u0440\u0438\u0433\u043b\u0430\u0441\u0438\u0442\u044c\u00bb; in-app invitation with who/what/role and \u00ab\u041f\u0440\u0438\u043d\u044f\u0442\u044c\u00bb / \u00ab\u041e\u0442\u043a\u043b\u043e\u043d\u0438\u0442\u044c\u00bb; revocable until accepted; lives 30 days", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_invite_no_account_no_disclosure", "label": "If the address has no account the server does not reveal it: invitation waits for signup; link can be copied to a messenger", "file_type": "rationale", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_shared_with_me", "label": "Recipient sees shared items in \u00ab\u041e\u0431\u0449\u0438\u0435 \u0441\u043e \u043c\u043d\u043e\u0439\u00bb in the sidebar of each space", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_remove_leave_rekey", "label": "Owner can remove a person, recipient can leave; then notebook key is rotated so nothing new can be read", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What was already seen cannot be taken back \u2014 honest limitation of end-to-end encryption"}, {"id": "docs_decisions_0054_account_sharing_simple_version_history_authors", "label": "Version history: who and when changed; open a version and see diff with previous (added highlighted, removed struck through); restore with edit right; collaborator cursors labelled with names instead of \u00ab\u0413\u043e\u0441\u0442\u044c\u00bb", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_agent_mode_owner_only", "label": "AI agents: \u00abfor agents\u00bb mode of a shared notebook enabled only by the owner; others see \u2728 badge", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_account_key_pairs", "label": "Encryption: every account has a key pair; notebook/note key encrypted with recipient's public key (server cannot read it); write rights checked by server (crypto.md \u00a77)", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_free_limit_50", "label": "Free; limit 50 people per notebook \u2014 server protection, not a pricing tier", "file_type": "rationale", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_link_sharing_stays", "label": "Link sharing for guests without account (D-13) stays as is", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_not_doing", "label": "Not doing: whole spaces, separate folders, groups, admins and other roles, comments and @mentions, private notebooks, activity log, team invite links, task assignees, mandatory security-code check, author colour highlighting \u2014 only by a separate decision", "file_type": "rationale", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0054_account_sharing_simple_implementation_phases", "label": "Phases: 1) contract (core, server): account keys, invitations, members, roles, key rotation, authors of updates/versions; 2) server: invitations, members, write checks, version authors, rotation; 3) web and iOS: share UI, invitations, \u00ab\u041e\u0431\u0449\u0438\u0435 \u0441\u043e \u043c\u043d\u043e\u0439\u00bb, roles, leave/remove, history with authors, diff and restore", "file_type": "concept", "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_decisions_0054_account_sharing_simple_d54", "target": "docs_decisions_0013_collaboration_sharing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0054_account_sharing_simple_d54", "target": "docs_decisions_0037_guest_links", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0054_account_sharing_simple_d54", "target": "docs_decisions_0048_isolated_spaces", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0054_account_sharing_simple_d54", "target": "docs_spec_08_sharing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0054_account_sharing_simple_d54", "target": "docs_architecture_contracts_crypto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 1.0}, {"source": "docs_decisions_0054_account_sharing_simple_link_only_context", "target": "docs_decisions_0013_collaboration_sharing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0054-account-sharing-simple.md", "source_location": null, "weight": 