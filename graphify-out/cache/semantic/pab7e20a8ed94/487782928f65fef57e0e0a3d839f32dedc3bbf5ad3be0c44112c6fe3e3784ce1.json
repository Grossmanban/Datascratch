s/architecture/contracts/strokes.md", "source_location": "L28-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_em_glyph_offset", "label": "text stroke coords: offset from anchored glyph origin (leading edge, baseline) in em", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_block_relative_coords", "label": "block / image / drawing coords in fractions of block width (x 0..1, y \u2265 0)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_margin_note_text_column_coords", "label": "Margin note (block) coords relative to text column: x may be < 0 or > 1, y from paragraph top", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_finished_points_only", "label": "Only finished stroke recorded: smoothed coalesced points, no predicted points", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_living_stroke_text_anchoring", "label": "Living stroke text anchoring: each point bound to nearest character of its line + em offset", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L48-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets handwriting reflow with text: the stroke follows the characters it touches."}, {"id": "docs_architecture_contracts_strokes_yjs_relative_position", "label": "Yjs relative positions (RelativePosition)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_right_char_boundary_rule", "label": "Point exactly on a boundary between two characters binds to the right character; at line end - to the last character", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clarification by ios-editor and web-editor streams 2026-10-25 so both platforms anchor identically."}, {"id": "docs_architecture_contracts_strokes_render_after_reflow", "label": "Render after reflow: anchor \u2192 absolute position (redone-aware) \u2192 glyph rect; point = glyph origin + (x,y) \u00d7 font size", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L57-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_line_break_segmentation", "label": "Line-break segmentation: neighbouring points on different line fragments split the stroke", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_deleted_text_rule", "label": "Deleted-text rule (D-35): points on deleted characters not drawn; segments < 2 points dropped; stroke kept in document", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stroke is not removed so that undoing the text deletion brings the annotation back."}, {"id": "docs_architecture_contracts_strokes_deleted_char_check_by_yjs_item", "label": "Deleted-character check by the Yjs item itself (redone-aware), not by resolution result", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs resolves a deleted character's relative position to a neighbour, not to empty, so resolution cannot reveal deletion."}, {"id": "docs_architecture_contracts_strokes_free_drawing", "label": "Free drawing far from text: any point > 3 em from nearest line \u2192 whole stroke anchorKind block at nearest paragraph (\u041f\u0420\u0415\u0414\u041b\u041e\u0416\u0415\u041d\u041e)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinator decision 2026-10-25 after user feedback 'I draw far from text and it disappears on release'; pen strokes must never be dropped. Drawing rides with its paragraph but does not stretch letter by letter."}, {"id": "docs_architecture_contracts_strokes_drawing_space_below_last_paragraph", "label": "Drawing space below last paragraph (\u2265 viewport height) only while drawing is available; content height includes free drawings", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_enclosing_strokes_rule", "label": "Enclosing strokes (D-58): frame/circle anchors only to enclosed lines", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enclosed lines = lines whose middle (0.35 em above baseline) lies within the stroke's vertical span; points nearer a neighbouring line bind to the nearest enclosed line. Frame moves and stretches only with the enclosed phrase instead of skewing on font/width change. Applied at stroke write time; existing strokes unchanged; arrows between lines enclose both lines."}, {"id": "docs_architecture_contracts_strokes_inkcontroller_enclosedlinehits", "label": "InkController.enclosedLineHits (iOS)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_linesforstroke", "label": "linesForStroke (web)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_anchor_rebase", "label": "Anchor rebase on undo/redo in the same transaction (\u00a74.1) \u2014 redone link is local, not synced", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L68-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Yjs 'redone' link is local and does not survive updates or reload, so other devices see restored text as new items; the undoing client rewrites anchors and others receive fixed anchors by normal sync."}, {"id": "docs_architecture_contracts_strokes_rebase_redone_anchors", "label": "rebaseRedoneAnchors(doc) \u2014 TS helper (iOS equivalent in DSCore)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_version_restore_rebase", "label": "Version restore: content and strokes restored; anchors recomputed via absolute indices", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_block_restructure", "label": "4.1a Block restructure (split, merge, type change, move) \u2192 replace stroke with re-anchored copy (new strokeId)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L75-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "y-prosemirror recreates moved text as new Yjs items, so old anchors would point at deleted characters and the annotation would vanish under D-35. Undo of the operation returns the original stroke. Proposed by ios-editor 2026-10-25, applies to web too."}, {"id": "docs_architecture_contracts_strokes_yprosemirror_recreates_moved_text", "label": "y-prosemirror recreates moved text with new Yjs items (old anchors point to deleted chars)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_web_restructure_followup_transaction", "label": "Web (\u00a74.1a): stroke copy written right after y-prosemirror transaction with tracked origin", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_tracked_origin_undo_merge", "label": "Tracked transaction origin: Y.UndoManager merges rebuild and stroke copy into one undo step", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_capture_anchor_offsets", "label": "captureAnchorOffsets \u2014 TS helper (@datascratch/shared/strokes)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_reanchor_strokes", "label": "reanchorStrokes \u2014 TS helper (@datascratch/shared/strokes)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_orphaned_stroke", "label": "Orphaned stroke (\u00a74.2): local orphanedAt when all anchors deleted; purged at compaction after 30 days (fallback createdAt)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L81-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs does not store when text was deleted, so the client records orphanedAt locally and clears it if anchors come back alive."}, {"id": "docs_architecture_contracts_strokes_thickness_curve", "label": "Thickness: width \u00d7 f(pressure) \u00d7 (fontSize/17) or (blockWidth/600); f(p)=0.35+0.65\u00b7p^0.8 shared across platforms", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L85-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared curve for all platforms so a stroke looks the same everywhere."}, {"id": "docs_architecture_contracts_strokes_tilt_and_highlighter", "label": "Tilt affects only pencil and marker; highlighter drawn under text with multiply blend", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "