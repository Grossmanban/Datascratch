{"nodes": [{"id": "docs_decisions_0062_shared_spaces_decision", "label": "D-62 \u041e\u0431\u0449\u0438\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (\u0440\u0435\u0448\u0435\u043d\u0438\u0435)", "file_type": "rationale", "source_file": "docs/decisions/0062-shared-spaces.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u043b\u0430\u0434\u0435\u043b\u0435\u0446 \u0445\u043e\u0447\u0435\u0442 \u0433\u043e\u0442\u043e\u0432\u0443\u044e \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0443: \u043e\u0431\u0449\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0441 \u043b\u044e\u0434\u044c\u043c\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044f \u0448\u0435\u0440\u0438\u043d\u0433 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 (D-54)."}, {"id": "docs_decisions_0062_shared_spaces_shared_space", "label": "\u041e\u0431\u0449\u0435\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e (\u043b\u0438\u0447\u043d\u043e\u0435 \u0438\u043b\u0438 \u043e\u0431\u0449\u0435\u0435)", "file_type": "concept", "source_file": "docs/decisions/0062-shared-spaces.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0062_shared_spaces_space_members_roles", "label": "\u0423\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0438 \u0438 \u0440\u043e\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (\u0432\u043b\u0430\u0434\u0435\u043b\u0435\u0446, \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440, \u0447\u0438\u0442\u0430\u0442\u0435\u043b\u044c; \u0434\u043e 50)", "file_type": "concept", "source_file": "docs/decisions/0062-shared-spaces.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},