{"nodes": [{"id": "apps_web_readme", "label": "web/README.md", "file_type": "document", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_web_client", "label": "\u0412\u0435\u0431-\u043a\u043b\u0438\u0435\u043d\u0442 Datascratch (Vite + React + TypeScript, PWA, \u0431\u0435\u0437 SSR)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full desktop replacement (D-02, D-03): no SSR, offline PWA installable; stream web-app (D-39)."}, {"id": "apps_web_readme_mock_server", "label": "Mock API/sync server (:8787)", "file_type": "code", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_server_url_env", "label": "VITE_DS_SERVER_URL (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0442\u043e\u0442 \u0436\u0435 \u0434\u043e\u043c\u0435\u043d, \u0447\u0442\u043e \u0438 API)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web is deployed on one domain with the API (infra/deploy), so default is same origin."}, {"id": "apps_web_readme_service_worker_server_paths", "label": "Service worker \u043d\u0435 \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0435 \u043f\u0443\u0442\u0438 (/v1/, /mcp, /oauth/, /.well-known/)", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise the OAuth consent page for agents would open as the app (src/lib/serverPaths.ts)."}, {"id": "apps