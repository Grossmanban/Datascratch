.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flag lives in the account document so the reminder appears/disappears on all devices; written to device first because registration screen runs before account sync (auth/recovery.ts)."}, {"id": "apps_web_readme_rotate_recovery_key", "label": "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439 \u043a\u043b\u044e\u0447 (POST /v1/auth/recovery-key, rotateRecoveryKey)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old key stops working immediately; devices with old key learn of rotation from security log and forget it."}, {"id": "apps_web_readme_security_events", "label": "\u0416\u0443\u0440\u043d\u0430\u043b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 (GET /v1/me/security-events)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_dexie_indexeddb", "label": "IndexedDB \u0447\u0435\u0440\u0435\u0437 Dexie (ds-device, ds-account-<userId>)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_webcrypto_key_wrapping", "label": "\u041c\u0430\u0441\u0442\u0435\u0440-\u043a\u043b\u044e\u0447 \u0432 \u043f\u0430\u043c\u044f\u0442\u0438, \u043e\u0431\u0451\u0440\u043d\u0443\u0442 \u043d\u0435\u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u043c\u044b\u043c AES-\u043a\u043b\u044e\u0447\u043e\u043c WebCrypto", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser never exposes the wrapping key bytes even to the site's own scripts; no key leaves to server except agent-mode notebook key (crypto.md \u00a78)."}, {"id": "apps_web_readme_logout_wipe", "label": "\u0412\u044b\u0445\u043e\u0434 \u0443\u0434\u0430\u043b\u044f\u0435\u0442 \u0431\u0430\u0437\u0443 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_syncclient", "label": "SyncClient (@datascratch/shared/sync)", "file_type": "code", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_dexiesyncstorage", "label": "DexieSyncStorage (src/data/syncStorage.ts)", "file_type": "code", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tables syncDocs and syncOutbox; batched getDocStates/setDocStates in one Dexie transaction."}, {"id": "apps_web_readme_yjs_doc", "label": "Yjs Y.Doc per document (account, notebook, note)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local edit written immediately to IndexedDB; un-acked outbox entries never deleted."}, {"id": "apps_web_readme_rest_op_queue", "label": "REST-\u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 (POST /v1/docs, resubscribe)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_migration_v3_v4", "label": "\u041c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u0431\u0430\u0437\u044b v3\u2192v4 (outbox \u2192 syncOutbox)", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unsent edits are not lost during migration."}, {"id": "apps_web_readme_snapshot_30_edits", "label": "\u0421\u043d\u0438\u043c\u043e\u043a \u043f\u0440\u0438 \u0443\u0445\u043e\u0434\u0435 \u043f\u043e\u0441\u043b\u0435 \u2265 30 \u043f\u0440\u0430\u0432\u043e\u043a (requestSnapshot)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for version history."}, {"id": "apps_web_readme_offline_reconnect", "label": "Reconnect on 'offline' event", "file_type": "rationale", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser does not always close the WebSocket on network loss."}, {"id": "apps_web_readme_sync_status_indicator", "label": "Sync status indicator in sidebar", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_move_note", "label": "\u041f\u0435\u0440\u0435\u043d\u043e\u0441 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u0431\u043b\u043e\u043a\u043d\u043e\u0442 (moveNoteToNotebook)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewraps note key with new notebook key, writes NoteMeta, PATCH /v1/docs/:id, removes old index entry with rollback on error; online only, not queued offline; nested notes stay in old notebook."}, {"id": "apps_web_readme_agents_mode", "label": "Notebook 'for agents' mode", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Honest warning that the server will be able to read the document."}, {"id": "apps_web_readme_virtualized_lists", "label": "\u0412\u0438\u0440\u0442\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0441\u043f\u0438\u0441\u043a\u043e\u0432 (10 000 \u0437\u0430\u043c\u0435\u0442\u043e\u043a, @tanstack/react-virtual)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only ~30 visible cards in DOM; snapshot keeps unchanged entries by reference, memo cards, cached Intl formatters (was the main delay). Title edit ~45 ms (was 8.5 s), thresholds in test."}, {"id": "apps_web_readme_cover", "label": "\u041e\u0431\u043b\u043e\u0436\u043a\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 \u0432 \u0432\u0435\u0431\u0435", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own image only, no stock gradients, no cover by default; compact header 150/190 px; meta.backdrop not offered in UI."}, {"id": "apps_web_readme_accessibility", "label": "\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c \u0438 \u0432\u0438\u0434 (axe-core WCAG 2.1 AA, \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430, \u0442\u0435\u043c\u0430, reduced motion)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text.tertiary (contrast ~2.7) only for icons/placeholders/done tasks per token contract; top bar is part of 'paper' per design review."}, {"id": "apps_web_readme_derived_data_indexer", "label": "\u0418\u043d\u0434\u0435\u043a\u0441\u0430\u0442\u043e\u0440 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 (tasks, noteIndex, MiniSearch)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debounced 0.6 s; title and tags copied into NoteMeta for lists."}, {"id": "apps_web_readme_attachments", "label": "\u0412\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043a\u0443\u0441\u043a\u0430\u043c\u0438 \u043f\u043e 1 \u041c\u0438\u0411", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each chunk a separate envelope with note key and ad (index, last flag); stored in IndexedDB first (offline), uploaded in background. Cover 2400 px in meta.cover, thumb 640 px in NoteMeta.coverThumb."}, {"id": "apps_web_readme_guest_session", "label": "Guest session (/s/:shareId#k=)", "file_type": "concept", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key in URL fragment never reaches server; session in memory only, no IndexedDB; presence encrypted with document key."}, {"id": "apps_web_readme_datascratch_shared", "label": "@datascratch/shared (core)", "file_type": "code", "source_file": "apps/web/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_web_readme_shared_libsodium_wrapper", "label": "src/lib/shared.ts \u2014 \u0430\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u044b\u0435 \u043e\u0431\u0451\u0440\u0442\u043a\u0438, \u0438\u043d\u0438\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0435 libsodium", "file_type": "code", 