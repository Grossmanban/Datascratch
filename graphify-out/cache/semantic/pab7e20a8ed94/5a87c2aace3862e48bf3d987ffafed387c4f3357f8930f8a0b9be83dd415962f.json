", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sharing_guests", "label": "Sharing and guests server rules", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L69-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_agents_rls", "label": "Agent access via ds_agent role with Row-Level Security", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L75-L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even a buggy query cannot read or write another notebook; notebook key decrypted only inside the grant-scoped transaction."}, {"id": "docs_spec_06_data_server_agents_package", "label": "@datascratch/agents package", "file_type": "code", "source_file": "docs/spec/06-data-server.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_background_jobs", "label": "Background jobs via pg-boss (doc-compact, cleanup, history-sweep)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L82-L84", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_metrics", "label": "Prometheus /metrics gated by METRICS_TOKEN", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L86-L88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_note_move", "label": "Note move between notebooks (server side)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L90-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_auto_deploy", "label": "Auto