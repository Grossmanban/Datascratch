ile_type": "concept", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "docs/decisions/0034-auth-email-password.md", "rationale": "With end-to-end encryption a forgotten password without recovery means lost notes (R-02)."}, {"id": "docs_decisions_0034_auth_email_password_sign_in_with_apple_rejected", "label": "Sign in with Apple \u2014 \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d: \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043d\u0443\u0436\u0435\u043d \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u0430\u0440\u043e\u043b\u044c \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f", "file_type": "concept", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "docs/decisions/0034-auth-email-password.md"}, {"id": "docs_decisions_0034_auth_email_password_two_independent_keys", "label": "\u0418\u0437 \u043f\u0430\u0440\u043e\u043b\u044f \u0432\u044b\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0434\u0432\u0430 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0445 \u043a\u043b\u044e\u0447\u0430: \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430 (\u0441\u0435\u0440\u0432\u0435\u0440 \u0445\u0440\u0430\u043d\u0438\u0442 \u0445\u044d\u0448) \u0438 \u0434\u043b\u044f \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f (\u043d\u0435 \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e)", "file_type": "concept", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "docs/decisions/0034-auth-email-password.md"}, {"id": "docs_decisions_0034_auth_email_password_d34", "label": "D-34 Email + password auth with recovery key", "file_type": "document", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "docs/decisions/0034-auth-email-password.md", "rationale": "E2E encryption needs a password anyway; one password for login and encryption (like Notesnook); recovery key avoids data loss (R-02). Sign in with Apple and passkeys rejected for now."}, {"id": "docs_decisions_0034_auth_email_password_d_34", "label": "D-34. \u0412\u0445\u043e\u0434: email + \u043f\u0430\u0440\u043e\u043b\u044c, \u043a\u043b\u044e\u0447 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0438\u0437 \u043f\u0430\u0440\u043e\u043b\u044f, \u043a\u043b\u044e\u0447 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f", "file_type": "document", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "docs/decisions/0034-auth-email-password.md", "rationale": "\u041f\u0430\u0440\u043e\u043b\u044c \u043d\u0443\u0436\u0435\u043d \u0434\u043b\u044f \u0441\u043a\u0432\u043e\u0437\u043d\u043e\u0433\u043e \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435; \u0431\u0435\u0437 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0437\u0430\u0431\u044b\u0442\u044b\u0439 \u043f\u0430\u0440\u043e\u043b\u044c = \u043f\u043e\u0442\u0435\u0440\u044f\u043d\u043d\u044b\u0435 \u0437\u0430\u043c\u0435\u0442\u043a\u0438 (R-02)"}], "edges": [{"source": "docs_decisions_0034_auth_email_password", "target": "docs_decisions_0034_auth_email_password_d_34_\u0432\u0445\u043e\u0434_email_\u043f\u0430\u0440\u043e\u043b\u044c_\u043f\u0430\u0440\u043e\u043b\u044c_\u0436\u0435_\u0434\u0430\u0451\u0442_\u043a\u043b\u044e\u0447_\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f_\u043a\u043b\u044e\u0447_\u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f", "relation": "contains", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/decisions/0034-auth-email-pas