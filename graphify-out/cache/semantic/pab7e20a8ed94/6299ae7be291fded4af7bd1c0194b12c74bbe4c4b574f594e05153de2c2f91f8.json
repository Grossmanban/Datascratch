{"nodes": [{"id": "docs_architecture_contracts_crypto_libsodium_all_platforms", "label": "libsodium on all platforms (libsodium-wrappers-sumo in TS, swift-sodium in iOS)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_key_hierarchy", "label": "Key hierarchy: password \u2192 Argon2id \u2192 loginKey/passwordKey \u2192 masterKey \u2192 notebookKey \u2192 noteKey", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-note key enables sharing one note by link without exposing the whole notebook; agent mode adds a server-wrapped notebookKey."}, {"id": "docs_architecture_contracts_crypto_login_key", "label": "loginKey (BLAKE2b keyed hash of authSeed, \"ds1|login\"); server stores Argon2id(loginKey)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_password_key", "label": "passwordKey (bytes 32..63 of KDF output, never leaves device)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_master_key", "label": "masterKey (32 random bytes, created at signup; encrypts account document)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_notebook_key", "label": "notebookKey (random per notebook; encrypts notebook document)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_note_key", "label": "noteKey (random per note; encrypts note document and its attachments)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_password_kdf", "label": "Password KDF: crypto_pwhash Argon2id13 (ops 3, mem 64 MiB, 64-byte output), NFKC, 16-byte salt from POST /v1/auth/prelogin", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KDF params stored with the salt so they can be raised later; loginKey and passwordKey are independent outputs, so the server cannot derive passwordKey."}, {"id": "docs_architecture_contracts_crypto_kdf_param_bounds", "label": "Client-side KDF parameter bounds (audit 2026-10-27): alg argon2id13, 3 \u2264 ops \u2264 10, 64 MiB \u2264 mem \u2264 256 MiB, else login/signup rejected", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hostile server (server address is user-entered, D-49) could lower parameters to get a cheaply brute-forceable loginKey and crack the password."}, {"id": "docs_architecture_contracts_crypto_envelope", "label": "Ciphertext envelope v1: version 0x01 + 24-byte nonce + XChaCha20-Poly1305-IETF (16-byte tag); base64url without padding", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_associated_data", "label": "Associated data binding (ds1|doc|\u2026, ds1|awareness|\u2026, ds1|key|\u2026, ds1|att|\u2026)", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds each ciphertext to its place so it cannot be swapped for another."}, {"id": "docs_architecture_contracts_crypto_recovery_key", "label": "Recovery key: 32 random bytes shown once as Crockford Base32 (52 chars, groups of 4, prefix DS1-); recoveryLoginKey stored as Argon2id", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_recovery_key_rotation", "label": "Recovery key rotation: new recoveryKey wraps masterKey, POST /v1/auth/recovery-key confirmed by loginKey; server atomically replaces, old key stops working, no re-encryption", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_recovery_flow", "label": "Recovery: prove recoveryLoginKey \u2192 wrappedMasterKeyRecovery \u2192 decrypt masterKey \u2192 new password; data not re-encrypted", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_password_change", "label": "Password change: only the masterKey wrapping is re-encrypted (new salt \u2192 new loginKey/passwordKey \u2192 new wrappedMasterKeyPassword)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_attachment_chunks", "label": "Attachments encrypted in 1 MiB plaintext chunks, each its own envelope (index + last flag in ad)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows resumable upload and per-chunk integrity checks."}, {"id": "docs_architecture_contracts_crypto_share_link_key_fragment", "label": "Share link https://<web-host>/s/<shareId>#k=<key>: noteKey or notebookKey in URL fragment, never sent to server", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_agent_mode_server_wrap", "label": "Agent mode (R-10): client sends notebookKey over TLS to PATCH /v1/notebooks/:id/mode, server wraps it with serverKey; decrypts only for valid agent requests", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_server_key_kms", "label": "serverKey: 32 bytes from DS_KMS_KEY env var (base64url), not stored in database", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_test_vectors", "label": "Crypto test vectors (packages/test-vectors/crypto/): KDF, envelopes, Crockford Base32, attachment chunks \u2014 same bytes in Swift and TS", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edg