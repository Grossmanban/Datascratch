{"nodes": [{"id": "docs_spec_03_pencil_pencil_spec", "label": "Apple Pencil in text (key feature spec)", "file_type": "document", "source_file": "docs/spec/03-pencil.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_handwriting_kinds", "label": "Handwriting input kinds (marks, margin notes, drawing block, images, Scribble)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_pen_gestures", "label": "Pen gestures (zigzag delete, underline, strike, lasso)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_living_stroke", "label": "Living stroke reflow (variant A)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stroke bound to words, not screen; on reflow it is redrawn and split per line."}, {"id": "docs_spec_03_pencil_anchor_hypothesis", "label": "Point anchor = CRDT RelativePosition + glyph offset in em", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CRDT relative positions survive text edits from other devices and agents."}, {"id": "docs_spec_03_pencil_pen_palette", "label": "Pen palette (DSPenToolbar / PenToolbar)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_textkit2_layer", "label": "Custom stroke layer over TextKit 2", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PKCanvasView cannot bind strokes to text."}, {"id": "docs_spec_03_pencil_web_pen_layer", "label": "Web pen layer (packages/web-editor/src/pen)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_reanchoring", "label": "Stroke reanchoring on block split/merge/move", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "y-prosemirror recreates text as new Yjs elements on Enter/Backspace merge/type change, so without reanchoring the mark would vanish per D-35; replaced with copy (new strokeId, same points) in the same undo step."}, {"id": "docs_spec_03_pencil_free_drawing", "label": "Free drawing far from text (anchorKind block)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any stroke with a point farther than 3 em from text is kept whole at the nearest paragraph; drawn ink is never dropped."}, {"id": "docs_spec_03_pencil_lasso", "label": "Lasso (strokes + text selection)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_ios_editor", "label": "iOS editor DSEditor (DSInk, DSEditorModel, DSEditor)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UITextView in TextKit 2 mode gives system keyboard, selection, dictation, VoiceOver and Scribble for free; the document is the source of truth."}, {"id": "docs_spec_03_pencil_core_animation_render", "label": "Core Animation stroke rendering (CAShapeLayer)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No extra buffering frame, crisp at any scale, scroll redraws nothing; live stroke frozen in chunks so long lines are as fast as short; Metal is fallback."}, {"id": "docs_spec_03_pencil_hold_gestures", "label": "Draw-and-hold pen gestures", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a ~0.5 s hold the stroke stays ink, otherwise hand underlining or hatching would be impossible."}, {"id": "docs_spec_03_pencil_promotion", "label": "ProMotion 80-120 Hz while drawing", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_paper_ruling", "label": "Paper ruling follows text line height", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L101", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_chisel_tip", "label": "Chisel tip for marker (after MVP)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_spec_03_pencil_pencil_spec", "target": "docs_decisions_readme_d_05", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/03-pencil.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_spec_03_pencil_pencil_spec", "target": "docs_decisions_readme_d_06", "relation": "r