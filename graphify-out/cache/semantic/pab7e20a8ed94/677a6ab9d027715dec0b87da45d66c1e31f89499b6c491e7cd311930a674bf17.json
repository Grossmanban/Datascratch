null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_pre_hello_frame_limits", "label": "Before hello: frame \u2264 64 KB (else close 1009), malformed message \u2192 close 4400", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_rate_limited_retry_after", "label": "rate_limited error may carry retryAfterMs \u2014 client must not resend or reconnect earlier (audit 2026-10-27)", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_skip_undecryptable_item", "label": "Client skips undecryptable/unappliable item, reports {docId, seq, deviceId, reason}, may resubscribe once with since: 0", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_snapshot_compaction", "label": "Snapshots and compaction (R-05): >500 updates or >1 MiB since last snapshot, and on document close after \u226530 local edits (snapshots are history versions)", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_snapshot_message", "label": "snapshot \u2014 upload encrypted state snapshot covering all updates up to baseSeq", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_sync_permissions", "label": "Permissions: user \u2014 own account docs (registered via POST /v1/docs before first push); guest \u2014 shared docs, push only with edit", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_connection_rate_limits", "label": "Rate limits: message-rate excess keeps connection open (client pauses, resends unacked); connection limit 10 per account / 30 per IP \u2192 rate_limited + close 1013", "file_type": "rationale", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message throttling without disconnect avoids churn; reconnect gated by retryAfterMs"}, {"id": "docs_architecture_contracts_sync_protocol_per_doc_ordering", "label": "Mandatory ordering: seq assignment and broadcast serialized per document; ack only after write; lastSeq = max(seq); gaps allowed", "file_type": "rationale", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Out-of-order delivery could lose an update on disconnect since client stores lastSeq = max(seq)"}, {"id": "docs_architecture_contracts_sync_protocol_snapshot_on_subscribe", "label": "Subscribe with since < latest snapshot seq always returns latest snapshot + later updates (2026-10-26)", "file_type": "rationale", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fewer updates to apply; client that skipped a corrupt update recovers from a later snapshot"}, {"id": "docs_architecture_contracts_sync_protocol_subscribe_before_push", "label": "Client subscribes to a document before its first push", "file_type": "rationale", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise lastSeq = max(ack) could skip other devices' earlier updates"}, {"id": "docs_architecture_contracts_sync_protocol_agents_not_websocket", "label": "Agents do not connect via WebSocket \u2014 they work via MCP/REST; server applies their edits as ordinary updates", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_doc_sync_unit", "label": "Sync unit: Yjs document (account, notebook, note)", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_test_vectors", "label": "Sync test vectors (packages/test-vectors/sync/): JSON examples of all messages, schema checked in TS and Swift", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_websocket_transport", "label": "Transport wss://<host>/v1/sync: JSON text frames with type, base64url without padding, WebSocket ping/pong every 25 s", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_server_seq", "label": "Server assigns per-document seq to encrypted Yjs updates, stores and relays