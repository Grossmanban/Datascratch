{"nodes": [{"id": "docs_architecture_contracts_sync_protocol_ack_message", "label": "ack \u2014 update/snapshot accepted and stored (docId, clientMsgId, seq; for snapshot seq = baseSeq)", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_awareness_ephemeral", "label": "awareness \u2014 cursors/presence: encrypted, not stored, only relayed", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_client_messages", "label": "Client messages: hello, subscribe (1\u20131000 docs), unsubscribe, push, snapshot, awareness", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_error_codes_limits", "label": "Error codes: bad_request, unauthorized, device_revoked (with reason, close 4410), forbidden, doc_not_found, payload_too_large (2 MiB update / 16 MiB snapshot, decoded bytes), rate_limited, protocol_mismatch, internal", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_error_ref_rule", "label": "error ref = clientMsgId for push/snapshot errors, else docId", "file_type": "concept", "source_file": "docs/architecture/contracts/sync-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_sync_protocol_guest_device_id", "label": "Guest devic