{"nodes": [{"id": "docs_decisions_0049_server_address_in_app_d49", "label": "D-49: server address entered in the app, not baked into the build (\u0420\u0415\u0428\u0415\u041d\u041e, user 2026-10-26; several servers at once \u2014 stage 6)", "file_type": "document", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_build_time_server_url", "label": "Problem: iOS server address set at build time (DS_SERVER_URL) \u2014 a server move needs a new build; self-hosters cannot connect from a TestFlight build", "file_type": "rationale", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User: the server must not be baked into the build but entered manually, and an invite link should say which server to register on."}, {"id": "docs_decisions_0049_server_address_in_app_server_field_on_login", "label": "\u00ab\u0421\u0435\u0440\u0432\u0435\u0440\u00bb field on sign-in/sign-up, our server by default; checked via GET /v1/health before sign-in; stored with the account; change server = sign out and sign in elsewhere; current server shown in settings", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_links_carry_server", "label": "Share and invite links carry the server address \u2014 opening a link preselects the server, user signs in/up and gets the shared content", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_multi_server_accounts", "label": "Future (stage 6): several servers/accounts at once \u2014 mail-style account switcher, each with own server, spaces and keys", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_web_own_domain", "label": "Web version keeps using its own domain's server (served by the server itself); server choice in web comes with multi-account", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_universal_links_limit", "label": "Universal Links only open the app for domains listed in the build; foreign-server links open in browser with \u00ab\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438\u00bb via datascratch:// scheme", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_https_only_check", "label": "Address validation: https:// only (localhost allowed for development); server name and version from /v1/health shown before password", "file_type": "concept", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0049_server_address_in_app_server_learns_only_connection", "label": "Server learns only that the person connected; keys and password still never leave the device", "file_type": "rationale", "source_file": "docs/decisions/0049-server-address-in-app.md", "source_location": "L23", "so