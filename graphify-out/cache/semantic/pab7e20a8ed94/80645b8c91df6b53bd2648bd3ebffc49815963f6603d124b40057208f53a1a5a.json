ibutor": null}, {"id": "docs_spec_06_data_server_server_responsibilities", "label": "Server responsibilities: accounts, storing/relaying encrypted changes, attachments, realtime, API and MCP, handwriting PNG render for agents", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_fastify_app_server", "label": "App server: Node.js + TypeScript (Fastify) \u2014 sync, realtime, API, MCP", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_postgresql_drizzle", "label": "PostgreSQL via Drizzle (D-30): accounts, notebooks, rights, tokens, encrypted updates, history snapshots, agent log; also pg-boss job queue", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_file_storage_interface", "label": "File storage behind interface: disk folder by default, external S3-compatible optional (D-26, no MinIO)", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L23,L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_no_redis_d_25", "label": "No Redis: single process, in-memory realtime broadcast behind an interface (swap to LISTEN/NOTIFY or Redis/Valkey for scaling) (D-25)", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_compose_self_hosting", "label": "Self-hosting: docker compose up \u2014 server + PostgreSQL; VPS 2 cores, 2\u20134 GB, ~300\u2013400 MB idle", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_backups_r_11", "label": "Daily off-VPS backups of DB and files with verified restore (R-11)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_server_implementation", "label": "Server implementation (stream server, 2026-10-25): rules beyond the contracts, status PROPOSED", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L37-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sessions", "label": "Login and sessions (D-34): server stores Argon2id(loginKey/recoveryLoginKey) m=19MiB t=2; fake deterministic prelogin salt (HMAC) for unknown email, constant timing; device = session; access JWT 15 min with userId+deviceId", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L41-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keys are already high-entropy since the client ran heavy Argon2id; fake salt prevents email enumeration"}, {"id": "docs_spec_06_data_server_refresh_token_rotation", "label": "One-time refresh token (30 days): reuse = theft, device revoked; password change revokes other devices, recovery revokes all", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L46-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_session_device_id", "label": "Session carries deviceId; signup and recovery/finish accept optional deviceName", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_seq_ordering", "label": "seq assigned in transaction under document row lock, strictly increasing without gaps; live updates delivered in seq order; idempotent push by clientMsgId", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L52-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_device_id_scheme", "label": "deviceId in updates: user \u2014 from access token; guest \u2014 guest:<22-char hash of shareId+deviceId>; agent \u2014 agent:<grantId>", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sync_errors", "label": "Malformed message \u2192 error bad_request (ref = clientMsgId); protocol_mismatch only for unsupported version; deletion \u2192 doc_not_found", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L55,L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sync_limits", "label": "Sync limits: update 2 MB, snapshot 50 MB, awareness 64 KB, 100 msg/s per connection (burst x5); awareness only for subscribed docs", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_snapshots_history_r_05", "label": "Snapshots (R-05): client snapshots at >500 updates / >1 MB; versions = snapshots (GET /v1/docs/:id/versions); server snapshots agent notebooks itself", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L59-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_snapshot_on_close", "label": "Snapshot on leaving a document after >=30 edits since last snapshot (PROPOSED by web-app)", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise history versions are too sparse"}, {"id": "docs_spec_06_data_server_history_retention_policy", "label": "History retention: covered updates kept 7 days; snapshots all for 7 days, daily to 30 days, weekly to a year, monthly after; HISTORY_* vars", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L63-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_first_sync_batching", "label": "First sync: subscribe batched 200 docs per query when <=100 updates; backpressure at 4 MB unread; bench ~1.2 s server for 10 000 notes (target spec/11 under a minute)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L65-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sharing_guests", "label": "Sharing and guests (D-13, D-37): notebook share covers all notes incl. future; guest token lives as long as link; guests read/upload attachments with edit, never delete; deletion revokes links", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L68-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_agents_rls", "label": "Agents: @datascratch/agents package; each agent request in transaction under PostgreSQL role ds_agent with Row-Level Security per grant; write only with read_write; consent screen via POST /v1/auth/web-session", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L74-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even a buggy query cannot read or write another notebook; notebook key decrypted only inside such a request"}, {"id": "docs_spec_06_data_server_pgboss_jobs", "label": "pg-boss jobs: doc-compact (after snapshot), cleanup (hourly), history-sweep (daily)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L81-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_metrics", "label": "Observability: GET /metrics (Prometheus) with Bearer METRICS_TOKEN; no route without token", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L85-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_move_note", "label": "Move note between notebooks: PATCH /v1/docs/:id { notebookId }; history, attachments, key unchanged (client rewraps key); old share guests lose note; agent access recomputed by RLS", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L89-L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_automated_deploy", "label": "Automated deploy workflow: GHCR images (server + web/Caddy), SSH to VPS (DEPLOY_HOST, DEPLOY_SSH_KEY), idempotent provisioning, migrations \u2192 compose up \u2192 HTTPS checks, rollback on failure; one domain or sslip.io; CI on VPS emulation", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L93-L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_trash", "label": "Trash: trashedAt encrypted in notebook index; after 30 days client calls DELETE /v1/docs/:id, server deletes doc, history, attachments at once", "file_type": "concept", "source_file": "docs/