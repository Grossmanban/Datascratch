{"nodes": [{"id": "docs_decisions_0065_voice", "label": "D-65 Voice ADR", "file_type": "document", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_d_65", "label": "D-65 Voice: dictation, conversation recording, AI text processing", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner wants to dictate notes and record conversations with clean speaker-separated transcripts, minutes or formatted documents on iOS and web; service keys cannot live in client apps (extracted in minutes), so the server holds them."}, {"id": "docs_decisions_0065_voice_elevenlabs_scribe_v2", "label": "ElevenLabs Scribe v2 (speech recognition)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On three of the owner's recordings more accurate than AssemblyAI, especially with overlapping speech, and 2-3x faster."}, {"id": "docs_decisions_0065_voice_assemblyai_fallback", "label": "AssemblyAI (fallback speech recognition)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worse on interruptions and slower; kept as fallback if ElevenLabs is unavailable."}, {"id": "docs_decisions_0065_voice_gpt_5_6_luna", "label": "openai/gpt-5.6-luna via OpenRouter (text AI)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the comparison caught both revised decisions, invented nothing, costs about 3 cents per hour of recording."}, {"id": "docs_decisions_0065_voice_best_quality_sonnet", "label": "Best quality mode: anthropic/claude-sonnet-5.5", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best quality but about 10x more expensive, so offered only as an opt-in setting."}, {"id": "docs_decisions_0065_voice_openrouter", "label": "OpenRouter", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_default_voice_text_models", "label": "DEFAULT_VOICE_TEXT_MODELS config", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_audio_stored_in_note", "label": "Conversation audio stored in note as encrypted attachment", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_owner_pays", "label": "Owner pays for ElevenLabs, AssemblyAI and OpenRouter keys", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_admin_access_quota", "label": "Voice access and monthly quota managed by server admin (600/120 min, UTC month)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_voice_agentedit_highlight", "label": "Voice result highlighted as agentEdit \"\u0413\u043e\u043b\u043e\u0441\"", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_format_styles", "label": "\"\u041e\u0444\u043e\u0440\u043c\u0438\u0442\u044c\" styles: document, plan, minutes, article, letter, notes", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_text_ai_rules", "label": "Text AI rules: invent nothing, keep meaning, \"(\u043d\u0435\u0440\u0430\u0437\u0431\u043e\u0440\u0447\u0438\u0432\u043e)\", profanity setting", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_clean_task", "label": "Transcript cleaning task", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_minutes_task", "label": "Conversation minutes task (\u041a\u043e\u0440\u043e\u0442\u043a\u043e / \u0420\u0435\u0448\u0435\u043d\u0438\u044f / \u041f\u0435\u0440\u0435\u0434\u0443\u043c\u0430\u043b\u0438 / \u0417\u0430\u0434\u0430\u0447\u0438 / \u0413\u043b\u0430\u0432\u043d\u043e\u0435)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0065_voice_server_intermediary", "label": "Server as voice intermediary (in memory, no storage or logs) \u2014 PROPOSED", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients hold no keys; audio and text pass through server memory only, logs keep only sizes, duration, error codes and model."}, {"id": "docs_decisions_0065_voice_e2e_exception", "label": "Honest exception from end-to-end encryption with first-use consent \u2014 PROPOSED", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recognition and processing are impossible without the server and external services seeing plaintext audio and text; notes and audio themselves remain encrypted."}, {"id": "docs_decisions_0065_voice_rejected_deepseek", "label": "DeepSeek (rejected for text)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheaper but weaker and drier minutes; hosting in China excluded for owner texts."}, {"id": "docs_decisions_0065_voice_rejected_claude_haiku", "label": "Claude Haiku (rejected)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheap and fast but invents items in minutes, violating the \"invent nothing\" rule."}, {"id": "docs_decisions_0065_voice_on_device_recognition", "label": "On-device recognition (Apple Speech, Whisper in browser) \u2014 considered", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No E2E exception, but no speaker separation and notably worse on colloquial Russian; may return as offline dictation mode."}, {"id": "docs_decisions_0065_voice_stages", "label": "D-65 implementation stages (contract, server, clients, voiceTime later)", "file_type": "concept", "source_file": "docs/decisions/0065-voice.md", "source_lo