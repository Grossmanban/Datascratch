{"nodes": [{"id": "docs_decisions_0051_minimal_mode_d51", "label": "D-51: minimalism (KISS) \u2014 notes only by default; tasks, calendar, tabs, collections in \u00abextended mode\u00bb (\u0420\u0415\u0428\u0415\u041d\u041e, user, 2026-10-26)", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User wants a minimalist app \u00ablike Notesnook\u00bb: notes with good formatting, pen, AI-agent access and sharing; finished work must not be lost, so features are hidden behind a build flag rather than deleted"}, {"id": "docs_decisions_0051_minimal_mode_user_request_kiss", "label": "Context: user asks to remove calendar, tasks and open tabs but keep spaces; KISS; keep the work behind an \u00abextended mode\u00bb build switch", "file_type": "document", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L7-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_default_mode", "label": "Default mode: spaces (D-48), notebooks, folders, notes, tags, favourites, search and \u2318K; full editor with pen in text; AI agents (MCP), link sharing; version history, encryption, sync", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L13-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_inline_checklists_kept", "label": "Inline checklists stay (formatting); task dates and reschedule menu only in extended mode; existing dates kept in data and shown as an inert text label", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_extended_mode_only", "label": "Extended mode only: Tasks screen (Inbox / Today / Upcoming / All), Inbox, task dates and deadlines, reminders; Calendar and daily notes; tabs (\u00a712.6); collections (\u00a712.5)", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L20-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_team_tasks_future", "label": "Future team tasks (assignees, kanban, manager screen) \u2014 extended mode", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_extended_mode_flag", "label": "Single extendedMode flag on all clients, set by build configuration, default false", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One switch in build config keeps the default product minimal without forking code"}, {"id": "docs_decisions_0051_minimal_mode_ios_ds_extended_mode", "label": "iOS: DS_EXTENDED_MODE in xcconfig \u2192 DSExtendedMode key in Info.plist", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_code_kept_compiled", "label": "Extended-mode code is not deleted or commented out \u2014 always compiled, hidden by a flag check in one place (feature registry)", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commented-out code rots and breaks the build unnoticed; compiled code stays checked"}, {"id": "docs_decisions_0051_minimal_mode_extended_tests_keep_running", "label": "Extended-feature tests keep running: UI tests enable the mode by launch argument -ds-extended-mode YES / environment variable", "file_type": "concept", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_no_data_migration", "label": "Data unchanged, no migration: notes, dated tasks, tabs in the account document stay as is; normal-mode client does not touch them", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_option_build_flag_chosen", "label": "Option chosen: build flag, code alive and under tests \u2014 nothing lost, easy to bring back", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_option_comment_out_rejected", "label": "Rejected: comment the code out \u2014 commented code breaks quickly and is not checked", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_option_delete_rejected", "label": "Rejected: delete the code \u2014 user wants to keep the work", "file_type": "rationale", "source_file": "docs/decisions/0051-minimal-mode.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0051_minimal_mode_option_settings_toggle_rejected", "label": "Rejected for now: a settings toggle for everyone \u2014 KISS, user should not see extra options", "file_type": "rationale", "source_file": "