{"nodes": [{"id": "docs_spec_03_pencil", "label": "Spec 3: Apple Pencil in Text", "file_type": "document", "source_file": "docs/spec/03-pencil.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_live_stroke", "label": "Live Stroke (D-05, variant A)", "file_type": "rationale", "source_file": "docs/spec/03-pencil.md", "source_location": "\u041f\u0435\u0440\u0435\u043a\u043b\u0430\u0434\u043a\u0430 \u0442\u0435\u043a\u0441\u0442\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stroke is bound to words, not screen; on reflow it is redrawn and split by lines. Decision D-05, \u0420\u0415\u0428\u0415\u041d\u041e."}, {"id": "docs_spec_03_pencil_handwriting_kinds", "label": "Handwriting Input Kinds", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_text_marks", "label": "Text Marks (underline, strike, circle, arrow)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_margin_notes", "label": "Margin Notes", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_drawing_block", "label": "Drawing Block", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_image_drawing", "label": "Drawing on Images", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_system_scribble", "label": "System Scribble (no recognition, D-07)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0412\u0438\u0434\u044b \u0440\u0443\u043a\u043e\u043f\u0438\u0441\u043d\u043e\u0433\u043e \u0432\u0432\u043e\u0434\u0430", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recognition of already-drawn ink is not done (D-07)."}, {"id": "docs_spec_03_pencil_pen_gestures", "label": "Pen Gestures (zigzag, underline, strike, lasso)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0416\u0435\u0441\u0442\u044b \u043f\u0435\u0440\u043e\u043c", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_anchor_storage", "label": "Stroke Points as Glyph Anchor + Offset", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Points stored as (anchor on character, dx/dy relative to glyph in font-size units) so they can be recomputed on reflow; stroke breaks where adjacent points land on different lines."}, {"id": "docs_spec_03_pencil_crdt_relative_position", "label": "CRDT Relative Position Anchors (Yjs)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchors are Yjs RelativePosition so they survive text edits including from other devices and the agent."}, {"id": "docs_spec_03_pencil_yrs_prototype", "label": "Yrs in Prototype (D-27)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u0413\u0438\u043f\u043e\u0442\u0435\u0437\u0430 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text is stored in Yrs from the start to test both the Swift Yrs wrapper and anchor survival."}, {"id": "docs_spec_03_pencil_open_prototype_questions", "label": "Open Questions for Prototype", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u041d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u043d\u0430 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u0435", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_03_pencil_stroke_format_versioning", "label": "Stroke Format Versioning (R-03)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u041d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u043d\u0430 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f\u0435", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stroke storage format carries a version number from day one because data lives for years."}, {"id": "docs_spec_03_pencil_deleted_text_stroke", "label": "Stroke on Deleted Text (R-04)", "file_type": "concept", "source_file": "docs/spec/03-pencil.md", "source_location": "\u041d\