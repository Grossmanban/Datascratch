{"nodes": [{"id": "docs_spec_06_data_server_data_model_overview", "label": "Data model overview: CRDT block tree text, handwriting layer with anchors, encrypted attachments, metadata, formats versioned from day one (R-03)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L5-L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_server_responsibilities", "label": "Server responsibilities: accounts, encrypted relay, attachments, realtime, API and MCP, handwriting PNG render", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_server_components", "label": "Server components: Fastify app, PostgreSQL (Drizzle, pg-boss), disk/S3 file storage", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L17-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_no_redis_inprocess_broadcast", "label": "No Redis (D-25): single process, in-memory realtime broadcast behind an interface", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interface allows plugging PostgreSQL LISTEN/NOTIFY or Redis/Valkey later without touching other code."}, {"id": "docs_spec_06_data_server_file_storage_interface", "label": "File storage interface: disk by default, external S3 optional (no MinIO, D-26)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L23-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_compose_self_hosting", "label": "Self-hosting with one docker compose up: server + PostgreSQL, VPS 2 cores / 2-4 GB, ~300-400 MB idle", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L29-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_backups_r_11", "label": "Daily off-VPS backups of DB and files, restore verified (R-11)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L33-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_login_sessions", "label": "Login and sessions (D-34): Argon2id of login keys, fake salt for unknown email, device = session, JWT 15 min, one-time refresh 30 days with reuse detection", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L41-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side Argon2id is light (m=19 MiB, t=2) because keys are already high-entropy; fake salt and equal timing hide whether an email exists; reuse of a refresh token signals theft."}, {"id": "docs_spec_06_data_server_sync_rules", "label": "Sync rules: seq under doc row lock without gaps, idempotent push by clientMsgId, deviceId forms (user / guest:<hash> / agent:<grantId>), bad_request, limits 2 MB / 50 MB / 64 KB awareness / 100 msg/s", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L50-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_snapshots_versions", "label": "Snapshots by clients (>500 updates / >1 MB, and on leaving a doc after >=30 edits - PROPOSED), by server for agent notebooks; history versions = snapshots", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L61-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without the on-close snapshot, history versions would be too sparse (proposed by web-app stream)."}, {"id": "docs_spec_06_data_server_history_retention_policy", "label": "History retention: covered updates kept 7 days; snapshots all for 7 days, daily to 30 days, weekly to a year, monthly after (HISTORY_*)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L63-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_initial_sync_batching", "label": "First sync batching: 200 docs per request if <=100 updates, backpressure above 4 MB unread; 10 000 notes ~1.2 s server (~0.9 s without snapshots)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L65-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_sharing_guests", "label": "Sharing and guests (D-13, D-37): notebook share covers all notes incl. later ones; guest token lives as long as link; deleting revokes links", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L68-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_agent_rls", "label": "Agents (D-30): @datascratch/agents; each request under ds_agent role with Row-Level Security per grant; OAuth consent via POST /v1/auth/web-session", "file_type": "rationale", "source_file": "docs/spec/06-data-server.md", "source_location": "L74-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even a buggy query cannot read or write another notebook; notebook key decrypted only inside such a request."}, {"id": "docs_spec_06_data_server_background_jobs", "label": "pg-boss jobs: doc-compact, cleanup (hourly), history-sweep (daily)", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L81-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_metrics", "label": "Observability: GET /metrics (Prometheus) enabled by METRICS_TOKEN, Bearer auth", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L85-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_note_move", "label": "Moving a note between notebooks: PATCH /v1/docs/:id { notebookId }; key rewrapped by client; RLS recomputed", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L89-L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_spec_06_data_server_trash", "label": "Trash: trashedAt encrypted in notebook index; after 30 days client calls DELETE /v1/docs/:id", "file_type": "concept", "source_file": "docs/spec/06-data-server.md", "source_location": "L93-L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_spec_06_data_server_data_model_overview", "target": "docs_architecture_data_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/06-data-server.md", "source_location": "L5", "weight": 1.0}, {"source": "docs_spec_06_data_server_data_model_overview", "target": "docs_decisions_0031_crdt_yjs_d_31_crdt_yjs_\u0432\u0435\u0431_\u0441\u0435\u0440\u0432\u0435\u0440_\u0438_yrs_ios", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/spec/06-data-server.md", "source_location": "L3-L7", "weight": 1.0}, {"source": "docs_spec_06_data_server_data_model_overview", "target": "docs_architecture_contracts_strokes_anchor_kind", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/spec/06-data-server.md", "source_location": "L8", "weight": 1.0}, {"source": "docs_spec_06_data_server_ser