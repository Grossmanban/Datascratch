f\u043e TLS, \u0441\u0435\u0440\u0432\u0435\u0440 \u043e\u0431\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043e serverKey; \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0430\u0433\u0435\u043d\u0442\u0430 \u0441 \u0442\u043e\u043a\u0435\u043d\u043e\u043c", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_kdf_client_bounds", "label": "\u0413\u0440\u0430\u043d\u0438\u0446\u044b KDF \u043d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0435: argon2id13, 3 \u2264 ops \u2264 10, 64\u2013256 MiB (\u0430\u0443\u0434\u0438\u0442 2026-10-27)", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0435\u0440 (\u0430\u0434\u0440\u0435\u0441 \u0432\u0432\u043e\u0434\u0438\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c, D-49) \u043c\u043e\u0433 \u0431\u044b \u0437\u0430\u043d\u0438\u0437\u0438\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b, \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u0435\u0448\u0451\u0432\u044b\u0439 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0431\u043e\u0440\u0430 loginKey \u0438 \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u043f\u0430\u0440\u043e\u043b\u044c; \u0432\u043d\u0435 \u0433\u0440\u0430\u043d\u0438\u0446 \u0432\u0445\u043e\u0434/\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u043e\u0442\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f."}, {"id": "docs_architecture_contracts_crypto_auth_seed_login_key_derivation", "label": "loginKey = BLAKE2b(key=authSeed, \"ds1|login\"); \u0441\u0435\u0440\u0432\u0435\u0440 \u0445\u0440\u0430\u043d\u0438\u0442 Argon2id(loginKey)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0412\u044b\u0445\u043e\u0434\u044b KDF \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b: \u043f\u043e loginKey \u043d\u0435\u043b\u044c\u0437\u044f \u0443\u0437\u043d\u0430\u0442\u044c passwordKey."}, {"id": "docs_architecture_contracts_crypto_recovery_login_key", "label": "recoveryLoginKey = BLAKE2b(key=recoveryKey, \"ds1|recovery-login\")", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_agent_note_key_cache", "label": "\u041a\u044d\u0448 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043b\u044e\u0447\u0435\u0439 \u0437\u0430\u043c\u0435\u0442\u043e\u043a \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435: \u2264 10 \u043c\u0438\u043d, \u2264 10 000 \u0437\u0430\u043f\u0438\u0441\u0435\u0439, \u0441\u0431\u0440\u043e\u0441 \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 \u0440\u0435\u0436\u0438\u043c\u0430/\u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0438/\u043e\u0442\u0437\u044b\u0432\u0435", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u0421\u0443\u0436\u0430\u0435\u0442 \u043e\u043a\u043d\u043e, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043a\u043b\u044e\u0447\u0438 \u0436\u0438\u0432\u0443\u0442 \u0432 \u