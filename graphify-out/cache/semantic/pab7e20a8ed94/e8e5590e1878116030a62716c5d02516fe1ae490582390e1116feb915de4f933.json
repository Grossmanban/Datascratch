_file": "docs/architecture/contracts/crypto.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_loginkey", "label": "loginKey", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived separately from passwordKey so server cannot learn passwordKey from loginKey."}, {"id": "docs_architecture_contracts_crypto_recoverykey", "label": "recoveryKey", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "32 random bytes shown once as Crockford Base32 with DS1- prefix."}, {"id": "docs_architecture_contracts_crypto_recoveryloginkey", "label": "recoveryLoginKey", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_serverkey", "label": "serverKey (DS_KMS_KEY)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_argon2id_kdf", "label": "Argon2id password KDF", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ops=3, mem=64MiB, 64-byte output; NFKC password; params stored with salt for future upgrade."}, {"id": "docs_architecture_contracts_crypto_kdf_client_bounds", "label": "Client-side KDF parameter bounds", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hostile user-entered server (D-49) could downgrade KDF to make loginKey cheap to brute force; client rejects alg!=argon2id13, ops outside 3..10, mem outside 64..256MiB."}, {"id": "docs_architecture_contracts_crypto_ciphertext_envelope", "label": "Ciphertext envelope (XChaCha20-Poly1305)", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_associated_data", "label": "Associated data (ad) binding", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds ciphertext to its location so it cannot be substituted."}, {"id": "docs_architecture_contracts_crypto_recovery_key_replacement", "label": "Recovery key replacement", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_account_recovery", "label": "Account recovery", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_password_change", "label": "Password change", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the masterKey wrap is re-encrypted; data is not re-encrypted."}, {"id": "docs_architecture_contracts_crypto_attachment_chunking", "label": "Attachment chunk encryption (1 MiB)", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enables resumable upload and per-chunk integrity checks."}, {"id": "docs_architecture_contracts_crypto_link_sharing", "label": "Link sharing with key in URL fragment", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fragment after # is not sent to server."}, {"id": "docs_architecture_contracts_crypto_agent_mode", "label": "Agent mode (R-10)", "file_type": "rationale", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server wraps notebookKey with serverKey; decrypts only during authorized agent request; note keys cached <=10 min/10000 entries, flushed on mode exit, deletion, or permission change."}, {"id": "docs_architecture_contracts_crypto_test_vectors", "label": "Crypto test vectors (packages/test-vectors/crypto)", "file_type": "document", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_account_keys_sharing", "label": "Account keys and sharing (D-54)", "file_type": "concept", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_crypto_sharing_ts", "label": "packages/shared/src/crypto/sharing.ts", "file_type": "code", "source_file": "docs/architecture/contracts/crypto.md", "source_location": "L96", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_c