{"nodes": [{"id": "docs_architecture_contracts_strokes_contract", "label": "Strokes contract v1 (handwritten strokes)", "file_type": "document", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_strokes_ymap", "label": "Strokes stored in Y.Map \"strokes\" keyed by strokeId (UUIDv7)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_immutable_stroke", "label": "Stroke almost immutable after drawing; eraser deletes whole stroke or replaces with pieces (pixel eraser)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutability keeps CRDT merges simple: only anchors (rebase) and hidden (reserve) change after drawing."}, {"id": "docs_architecture_contracts_strokes_stroke_fields", "label": "Stroke fields: v, tool, color, width, opacity, anchorKind, blockId, anchors, points, hint, author, createdAt", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L11-26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_anchor_kind", "label": "anchorKind: text | block | image | drawing", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_stroke_hint", "label": "hint: recognised shape (free, underline, strike, circle, highlight, arrow, scribble) for agents and export", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_custom_hex_color", "label": "Ink colour token (ink.black\u2026) or custom #RRGGBB", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_points_packing", "label": "Points packing: 8 Float32 LE values (32 bytes) [a,x,y,pressure,altitude,azimuth,roll,t]", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L28-34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_em_glyph_offset", "label": "Text-anchored point offset from glyph origin in em of the anchor character", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_block_relative_coords", "label": "Block/image/drawing coords as fractions of block width (x 0..1, y \u2265 0)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_margin_note_text_column_coords", "label": "Margin-note coords relative to text column (x may be <0 or >1)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_finished_points_only", "label": "Only finished stroke stored: smoothed coalesced points, no predicted points", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicted points are speculative; storing only finished smoothed points keeps rendering identical on all clients."}, {"id": "docs_architecture_contracts_strokes_living_stroke_text_anchoring", "label": "Living stroke text anchoring: each point bound to nearest character of its line", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L48-53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_right_char_boundary_rule", "label": "Point exactly on character boundary anchors to the right character (end of line \u2192 last character)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agreed by ios-editor and web-editor streams 2026-10-25 so both clients produce identical anchors."}, {"id": "docs_architecture_contracts_strokes_render_after_reflow", "label": "Rendering after reflow: anchor \u2192 absolute position (redone-aware) \u2192 glyph rect; point = glyph origin + (x,y)\u00d7fontSize", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L57-60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_line_break_segmentation", "label": "Line-break segmentation: stroke splits into independent segments where neighbouring points lie on different line fragments", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_deleted_text_rule", "label": "Deleted-text rule (D-35): points on deleted characters not drawn; segments < 2 points dropped; stroke kept in document", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Undoing a text deletion must bring the annotation back, so the stroke stays in the document and is only hidden."}, {"id": "docs_architecture_contracts_strokes_deleted_char_check_by_yjs_item", "label": "Deleted-character check by the Yjs item itself (redone-aware), not by resolution result", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs resolves a deleted relative position to a neighbour, so resolution alone cannot detect deletion."}, {"id": "docs_architecture_contracts_strokes_free_drawing", "label": "Far stroke (> 3 em from any text line) saved whole as free drawing: anchorKind block of nearest paragraph", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User feedback: drawing far from text vanished on pen lift. Points must never be discarded. Status \u041f\u0420\u0415\u0414\u041b\u041e\u0416\u0415\u041d\u041e."}, {"id": "docs_architecture_contracts_strokes_drawing_space_below_last_paragraph", "label": "Editor keeps drawing space below last paragraph and includes free drawings in content height (iOS build 37: pen mode screen + screen near edge, text mode 1/3 screen)", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_enclosing_strokes_rule", "label": "Enclosures (D-58): frame/circle around lines anchors only to enclosed lines (line middle 0.35 em above baseline within stroke's vertical span)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So a frame moves and stretches only with the circled phrase and does not skew on font or width change."}, {"id": "docs_architecture_contracts_strokes_inkcontroller_enclosedlinehits", "label": "iOS InkController.enclosedLineHits", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_linesforstroke", "label": "Web linesForStroke", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_anchor_rebase", "label": "Anchor rebase on undo/redo in the same transaction (\u00a74.1) \u2014 redone link is local, not synced", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L68-72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Other devices see undo-restored text as new items, so the undoing client rewrites anchors and syncs them."}, {"id": "docs_architecture_contracts_strokes_rebase_redone_anchors", "label": "rebaseRedoneAnchors(doc) \u2014 TS helper (iOS equivalent in DSCore)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_version_restore_rebase", "label": "Version restore: content and strokes restored; anchors recomputed via absolute indices", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_block_restructure", "label": "Block restructure (split, merge, type change, move): stroke replaced by copy with new strokeId and recomputed anchors in same transaction (\u00a74.1a)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L75-77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "y-prosemirror recreates moved text as new Yjs items; without reanchoring the mark would vanish per D-35."}, {"id": "docs_architecture_contracts_strokes_yprosemirror_recreates_moved_text", "label": "y-prosemirror recreates moved text with new Yjs items", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_web_restructure_followup_transaction", "label": "Web: stroke copy written right after y-prosemirror transaction with tracked origin; Y.UndoManager merges both into one undo step", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_capture_anchor_offsets", "label": "captureAnchorOffsets (@datascratch/shared/strokes)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_reanchor_strokes", "label": "reanchorStrokes (@datascratch/shared/strokes)", "file_type": "code", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_orphaned_stroke", "label": "Orphaned stroke (\u00a74.2): local orphanedAt when all anchors deleted; purged at compaction after 30 days (fallback createdAt)", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L81-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Yjs does not record when text was deleted, so the client tracks orphanedAt locally."}, {"id": "docs_architecture_contracts_strokes_thickness_curve", "label": "Thickness: width \u00d7 f(pressure) \u00d7 (fontSize/17) or (blockWidth/600); f(p)=0.35+0.65\u00b7p^0.8 shared across platforms", "file_type": "rationale", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L85-87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared curve so strokes look identical on every platform."}, {"id": "docs_architecture_contracts_strokes_tilt_and_highlighter", "label": "Tilt affects only pencil and marker; highlighter drawn under text with multiply blend", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_test_vectors", "label": "Stroke test vectors packages/test-vectors/strokes (packing, anchor resolution, D-35) \u2014 mandatory for Swift and TS", "file_type": "concept", "source_file": "docs/architecture/contracts/strokes.md", "source_location": "L89-91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contracts_strokes_ts_types", "label": "TS types packages/shared/src/contracts/strokes.ts and codec packages/shared/src/strokes/", "file_type": "code", "source_file": "docs/architectu