{"nodes": [{"id": "docs_decisions_0052_image_fetch_proxy", "label": "D-52 ADR: pasted images by URL fetched via server (web)", "file_type": "document", "source_file": "docs/decisions/0052-image-fetch-proxy.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0052_image_fetch_proxy_server_fetch", "label": "Web asks own server to download pasted image (POST /v1/fetch-image), encrypts and uploads as attachment", "file_type": "rationale", "source_file": "docs/decisions/0052-image-fetch-proxy.md", "source_location": "L11-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web CSP connect-src 'self' forbids fetching foreign sites; it is the main barrier against injected code exfiltrating decrypted notes, so it must not be weakened. Without a server fetch, pasted <img src> stay links. Status \u0420\u0415\u0428\u0415\u041d\u041e (user, 2026-10-27)."}, {"id": "docs_decisions_0052_image_fetch_proxy_web_csp_connect_src_self", "label": "Web CSP connect-src 'self' \u2014 main exfiltration barrier, not weakened", "file_type": "concept", "source_file": "docs/decisions/0052-image-fetch-proxy.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0052_image_fetch_proxy_ssrf_restrictions", "label": "Mandatory server restrictions for image fetch (signed-in only, 60/min, http(s) 80/443, \u22643 redirects, image/* + signature, \u226420 MB, 15 s, no cookies/Referer)", "file_type": "rationale", "source_file": "docs/decisions/0052-image-fetch-proxy.md", "source_location": "L15-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_0052_image_fetch_proxy_private_network_block", "label": "Resolve to IP before request; block private/local/reserved IPv4/IPv6 ranges; connect to verified IP (anti DNS rebinding)", "file_type": "concept", "source_