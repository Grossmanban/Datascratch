# ---- infra/.env: settings for docker compose -------------------------------
# Copy:  cp .env.example .env   and fill in the values marked CHANGE.
# A random secret:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='

# Database (created automatically on first start)
POSTGRES_USER=datascratch
POSTGRES_PASSWORD=CHANGE-me-long-random-password
POSTGRES_DB=datascratch

# Your domain for HTTPS (only with: docker compose --profile https up -d)
DOMAIN=notes.example.com

# Where the server port is published: 127.0.0.1 (behind Caddy) or 0.0.0.0 (direct access)
SERVER_BIND=127.0.0.1
SERVER_PORT=8080

# ---- server ----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_URL=https://notes.example.com
# Web app address (OAuth consent page of AI agents sends users there to sign in)
APP_URL=https://app.example.com
CORS_ORIGINS=
# MCP clients (Claude, ChatGPT): advertise OAuth Client ID Metadata Documents. Set false if the server
# cannot reach the clients' hosts (e.g. claude.ai from some regions) — clients then register dynamically.
OAUTH_CLIENT_METADATA_DOCUMENTS=true

# CHANGE: random 32 bytes, base64url (see the command above)
DS_JWT_SECRET=
# CHANGE: random 32 bytes, base64url. Keep a copy OUTSIDE the server and outside backups.
DS_KMS_KEY=

# Files: disk (volume "files") or external S3
STORAGE_DRIVER=disk
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- backups (infra/backup.sh) ----------------------------------------------
# Keep local backups for this many days
BACKUP_KEEP_DAYS=14
# Optional: rclone remote to copy backups off the server, e.g. "storagebox:datascratch"
BACKUP_RCLONE_REMOTE=

# Optional: enables GET /metrics (Prometheus) with header  Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
