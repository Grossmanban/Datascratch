# Production front door: the web app and the API on one address.
# DS_SITE is the domain in direct mode (Caddy obtains and renews a Let's Encrypt
# certificate; for "localhost" its own CA — used by the end-to-end test), or
# "http://:8480" behind an existing reverse proxy that terminates TLS.
{
	servers {
		# Requests forwarded by a proxy on this host keep the client's address.
		trusted_proxies static private_ranges
	}
}

{$DS_SITE} {
	encode zstd gzip

	# Internal only: never exposed to the internet.
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}

	# API, sync WebSocket, MCP and OAuth for AI agents.
	@api path /v1/* /mcp /mcp/* /oauth/* /.well-known/oauth-*
	handle @api {
		reverse_proxy server:8080
	}

	# The web app (single-page app: unknown paths fall back to index.html).
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
