# Production front door: the web app and the API on one address.
# DS_SITE is the domain in direct mode (Caddy obtains and renews a Let's Encrypt
# certificate; for "localhost" its own CA — used by the end-to-end test), or
# "http://:8480" behind an existing reverse proxy that terminates TLS.
{
	servers {
		# Requests forwarded by a proxy on this host keep the client's address.
		trusted_proxies static private_ranges
	}
}

{$DS_SITE} {
	encode zstd gzip

	# No request body is larger than an attachment chunk (~1 MiB); sync frames are not bodies.
	request_body {
		max_size 16MB
	}

	# API, sync WebSocket, MCP and OAuth for AI agents: the server sets its own headers there.
	@api path /v1/* /mcp /mcp/* /oauth/* /.well-known/oauth-*
	@web not path /v1/* /mcp /mcp/* /oauth/* /.well-known/oauth-*

	# Security headers (same values as apps/web/src/lib/securityHeaders.ts, which the web e2e
	# suite runs under; a unit test there keeps both in step). HSTS also holds in edge mode:
	# the outer proxy serves the site over HTTPS.
	# The web app's CSP stays off the server's paths: a second CSP is enforced on top of the
	# server's own, and its form-action 'self' blocked the OAuth consent redirect to the agent.
	header @web Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{http.request.hostport}; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Internal only: never exposed to the internet.
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}

	handle @api {
		reverse_proxy server:8080
	}

	# The web app (single-page app: unknown paths fall back to index.html).
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
