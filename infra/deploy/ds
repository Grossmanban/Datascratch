#!/usr/bin/env bash
# Datascratch on this server: backups and the agents key (D-55). Run as root over SSH.
#   ds backup            make a backup now; prints the files and their sizes
#   ds backups           list the backups on this server
#   ds restore <file>    restore a backup (db-<time>.dump; the files-<time>.tar.gz next to it
#                        is restored too). Checks the backup first and keeps the current data
#                        as pre-restore-<time>.* (restore.sh)
#   ds key               what DS_KMS_KEY is and its value — terminal only, never in a log
#   ds key-saved         stop reminding about DS_KMS_KEY
#   ds quota <email> [<GB>|default]
#                        show an account's storage, or set its limit (new accounts get 1 GB;
#                        default = the server's USER_STORAGE_QUOTA_BYTES, 10 GB)
#   ds voice <email> [on|off|default|<minutes>]
#                        voice (D-65), also in the app for admins: show an account's access,
#                        switch it on or off, back to default, or set its minutes per month
set -euo pipefail

DIR="${DS_DIR:-/opt/datascratch}"
BACKUPS="$DIR/backups"
SAVED="$DIR/.kms-key-saved"
CALLER_DIR="$PWD"
cd "$DIR"

human() { numfmt --to=iec --suffix=B "$1" 2> /dev/null || echo "$1 B"; }

remind() {
  [ -f "$SAVED" ] && return 0
  echo "Reminder: save DS_KMS_KEY in your password manager — run: $DIR/ds key" >&2
}

key_block() {
  local key
  key=$(grep -E '^DS_KMS_KEY=' .env | cut -d= -f2-)
  cat << EOF

================================ DS_KMS_KEY ================================
  What:  the server key that opens notebooks in the "for AI agents" mode
         (it wraps their keys; private notebooks never depend on it).
  Where: $DIR/.env (line DS_KMS_KEY=...), readable by root only.
  Do:    save it in your password manager now.
  Note:  it is deliberately NOT in the backups. When you move to another
         server, put the same DS_KMS_KEY into the new .env before restoring.
  Lost:  agents lose access to their notebooks until you switch each of
         them to private and back in the app; your notes themselves are safe.

  DS_KMS_KEY=$key
=============================================================================
When it is saved:  $DIR/ds key-saved

EOF
}

case "${1:-}" in
  backup)
    remind
    out=$(./backup.sh)
    stamp=$(echo "$out" | sed -n 's/.*backup \([0-9TZ]*\) .*/\1/p' | head -1)
    [ -n "$stamp" ] || { echo "$out" >&2; exit 1; }
    for f in "$BACKUPS/db-$stamp.dump" "$BACKUPS/files-$stamp.tar.gz"; do
      [ -f "$f" ] && echo "$f  $(human "$(stat -c %s "$f")")"
    done
    echo "Copy them off the server, e.g.: scp root@<this-server>:$BACKUPS/*-$stamp.* ."
    ;;
  backups)
    remind
    shopt -s nullglob
    dumps=("$BACKUPS"/db-*.dump)
    [ ${#dumps[@]} -gt 0 ] || { echo "no backups yet (make one: $DIR/ds backup)"; exit 0; }
    for f in "${dumps[@]}"; do
      stamp=${f##*/db-}
      stamp=${stamp%.dump}
      size=$(stat -c %s "$f")
      [ -f "$BACKUPS/files-$stamp.tar.gz" ] && size=$((size + $(stat -c %s "$BACKUPS/files-$stamp.tar.gz")))
      echo "$stamp  $(human "$size")  $f"
    done
    ;;
  restore)
    db="${2:?usage: ds restore <db-<time>.dump>}"
    # A path as given (relative to where ds was run), else a name in the backups directory.
    case "$db" in /*) ;; *) if [ -f "$CALLER_DIR/$db" ]; then db="$CALLER_DIR/$db"; else db="$BACKUPS/$db"; fi ;; esac
    [ -f "$db" ] || { echo "no such backup: ${2}" >&2; exit 1; }
    files="${db%/*}/files-$(basename "$db" .dump | sed 's/^db-//').tar.gz"
    if [ -f "$files" ]; then ./restore.sh "$db" "$files"; else ./restore.sh "$db"; fi
    ;;
  key)
    # Only to a person at a terminal: never into a pipe, a file or a CI log.
    if [ ! -t 1 ]; then
      echo "ds key prints a secret: run it in an interactive SSH session." >&2
      exit 1
    fi
    key_block
    ;;
  key-saved)
    touch "$SAVED"
    echo "OK, no more reminders."
    ;;
  quota)
    email="${2:?usage: ds quota <email> [<GB>|default]}"
    gb="${3:-}"
    case "$gb" in
      '') query="SELECT email, pg_size_pretty(storage_bytes) AS used, coalesce(pg_size_pretty(storage_quota_bytes), 'default') AS quota FROM users WHERE email = :'email';" ;;
      default) query="UPDATE users SET storage_quota_bytes = NULL WHERE email = :'email' RETURNING email, 'default' AS quota;" ;;
      *[!0-9]*) echo "GB must be a whole number or 'default'" >&2; exit 2 ;;
      *) query="UPDATE users SET storage_quota_bytes = :gb::bigint * 1073741824 WHERE email = :'email' RETURNING email, pg_size_pretty(storage_quota_bytes) AS quota;" ;;
    esac
    # The e-mail goes in as a psql variable (quoted by psql), never into the SQL text.
    echo "$query" | docker compose exec -T postgres sh -c \
      'psql -X -q -U "$POSTGRES_USER" -d "$POSTGRES_DB" -P pager=off -v ON_ERROR_STOP=1 -v email="$1" -v gb="${2:-0}"' sh "$email" "$gb"
    ;;
  voice)
    email="${2:?usage: ds voice <email> [on|off|default|<minutes>]}"
    arg="${3:-}"
    month="date_trunc('month', now() AT TIME ZONE 'UTC')::date"
    ins="INSERT INTO voice_access (user_id, enabled, monthly_minutes) SELECT id"
    from="FROM users WHERE email = :'email' ON CONFLICT (user_id) DO UPDATE SET updated_at = now(), updated_by = NULL"
    case "$arg" in
      '') query="SELECT u.email, coalesce(a.enabled::text, 'default') AS voice,
            coalesce(a.monthly_minutes::text, 'default') AS minutes_per_month,
            round(coalesce(v.seconds, 0) / 60.0, 1) AS used_this_month, coalesce(v.cost_usd, 0) AS cost_usd
          FROM users u LEFT JOIN voice_access a ON a.user_id = u.id
          LEFT JOIN voice_usage v ON v.user_id = u.id AND v.month = $month
          WHERE u.email = :'email';" ;;
      on) query="$ins, true, NULL $from, enabled = true RETURNING 'on' AS voice;" ;;
      off) query="$ins, false, NULL $from, enabled = false RETURNING 'off' AS voice;" ;;
      default) query="DELETE FROM voice_access WHERE user_id = (SELECT id FROM users WHERE email = :'email') RETURNING 'default' AS voice;" ;;
      *[!0-9]*) echo "minutes must be a whole number, or on / off / default" >&2; exit 2 ;;
      # A new setting with minutes only keeps voice off until it is switched on.
      *) query="$ins, false, :gb::int $from, monthly_minutes = EXCLUDED.monthly_minutes RETURNING monthly_minutes AS minutes_per_month;" ;;
    esac
    echo "$query" | docker compose exec -T postgres sh -c \
      'psql -X -q -U "$POSTGRES_USER" -d "$POSTGRES_DB" -P pager=off -v ON_ERROR_STOP=1 -v email="$1" -v gb="${2:-0}"' sh "$email" "$arg"
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
