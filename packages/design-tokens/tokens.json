    "callout": { "size": 16, "weight": 400, "font": "text", "lineHeight": 1.5, "tracking": -0.2, "textStyle": "callout" },
    "footnote": { "size": 13, "weight": 400, "font": "text", "lineHeight": 1.5, "tracking": 0, "textStyle": "footnote" },
    "caption": { "size": 12, "weight": 500, "font": "text", "lineHeight": 1.5, "tracking": 0, "textStyle": "caption" }
