  },
  "width": { "normal": 720, "wide": 960, "full": null },
  "motion": {
    "snappy": { "response": 0.3, "damping": 0.85 },
    "smooth": { "response": 0.45, "damping": 0.9 },
    "gentle": { "response": 0.6, "damping": 1.0 }
  },
  "duration": { "fast": 120, "base": 200, "slow": 320 },
  "haptic": { "selection": "selection", "taskComplete": "success", "delete": "warning" }
