      "web": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"]
    }
  },
  "type": {
    "title": { "size": 34, "weight": 600, "font": "display", "lineHeight": 1.2, "tracking": -0.4, "textStyle": "largeTitle" },
