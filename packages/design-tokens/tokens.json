  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "9": 36, "10": 40 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "full": 9999 },
  "shadow": {
    "card": {
      "light": [
        { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#1D1C1A0D" },
        { "x": 0, "y": 8, "blur": 24, "spread": -6, "color": "#1D1C1A14" }
      ],
      "dark": [
        { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#00000040" },
        { "x": 0, "y": 8, "blur": 24, "spread": -6, "color": "#00000059" }
      ]
    },
    "popover": {
      "light": [
        { "x": 0, "y": 2, "blur": 6, "spread": 0, "color": "#1D1C1A0F" },
        { "x": 0, "y": 18, "blur": 48, "spread": -8, "color": "#1D1C1A29" }
      ],
      "dark": [
        { "x": 0, "y": 2, "blur": 6, "spread": 0, "color": "#00000059" },
        { "x": 0, "y": 18, "blur": 48, "spread": -8, "color": "#0000008C" }
      ]
