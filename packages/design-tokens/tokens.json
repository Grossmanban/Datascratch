      "ios": "New York",
      "web": ["Source Serif 4 Variable", "Source Serif 4", "ui-serif", "New York", "Georgia", "serif"]
    },
    "text": {
      "ios": "SF Pro Text",
      "web": ["Inter Variable", "Inter", "ui-sans-serif", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"]
    },
